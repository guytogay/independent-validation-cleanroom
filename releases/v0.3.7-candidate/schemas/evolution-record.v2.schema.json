{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ena/evolution-record.v2.schema.json",
  "title": "ENA Evolution Candidate Record v2 (v0.3.7 candidate.2)",
  "type": "object",
  "required": [
    "candidate_id",
    "created_at",
    "origin",
    "lifecycle_state",
    "expression_state",
    "selection_state",
    "signal_refs",
    "hypothesis",
    "change",
    "variation_space",
    "environment",
    "experiments",
    "evaluations",
    "expression_history",
    "integration_history",
    "archive",
    "migration"
  ],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "origin": {"type": "string", "enum": ["LOCAL_VARIATION", "MIGRATION_CANDIDATE", "RECOMBINATION", "OTHER"]},
    "lifecycle_state": {"type": "string", "enum": ["PROPOSED", "EXPERIMENTED", "INTEGRATED", "ARCHIVED", "RETIRED"]},
    "expression_state": {"type": "string", "enum": ["LATENT", "EXPRESSED"]},
    "selection_state": {"type": "string", "enum": ["UNASSESSED", "SUPPORTED", "PARTIAL", "NOT_SUPPORTED", "HARMFUL", "UNKNOWN"]},
    "source_packet": {"type": "string"},
    "source_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_candidate_id": {"type": "string"},
    "signal_refs": {"type": "array", "items": {"type": "string"}},
    "mutation_pressure_refs": {"type": "array", "items": {"type": "string"}},
    "triggered_obligation_refs": {"type": "array", "items": {"type": "string"}},
    "hypothesis": {"type": "string", "minLength": 1},
    "change": {"type": "string", "minLength": 1},
    "expected_outcomes": {"type": "array", "items": {"type": "string"}},
    "variation_space": {"type": ["string", "null"], "minLength": 1},
    "evolutionary_subject": {"type": "string"},
    "protected_subjects": {"type": "array", "items": {"type": "string"}},
    "environment": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "observation_plan": {"type": "string"},
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["experiment_id", "time", "actual_change"],
        "properties": {
          "experiment_id": {"type": "string", "minLength": 1},
          "time": {"type": "string", "format": "date-time"},
          "provenance": {"enum": ["LOCAL", "IMPORTED"]},
          "variation_space": {"type": ["string", "null"]},
          "actual_change": {"type": "string", "minLength": 1},
          "effect_boundary": {"type": "string"},
          "recovery": {"type": "string"},
          "external_authority_basis": {"type": "string"},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evaluation_id", "time", "outcomes", "selection", "evidence_refs"],
        "properties": {
          "evaluation_id": {"type": "string", "minLength": 1},
          "time": {"type": "string", "format": "date-time"},
          "provenance": {"enum": ["LOCAL", "IMPORTED"]},
          "outcomes": {"type": "object", "additionalProperties": {"enum": ["IMPROVED", "DEGRADED", "UNCHANGED", "UNKNOWN"]}},
          "selection": {"enum": ["SUPPORTED", "PARTIAL", "NOT_SUPPORTED", "HARMFUL", "UNKNOWN"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "negative_evidence": {"type": "array", "items": {"type": "string"}},
          "tradeoffs": {"type": "array", "items": {"type": "string"}},
          "unknowns": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"},
          "evidence_boundary": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "expression_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["expression_id", "time", "state", "trigger", "effect_materiality"],
        "properties": {
          "expression_id": {"type": "string", "minLength": 1},
          "time": {"type": "string", "format": "date-time"},
          "state": {"enum": ["LATENT", "EXPRESSED"]},
          "trigger": {"type": "string", "minLength": 1},
          "context": {"type": "string"},
          "effect_boundary": {"type": "string"},
          "effect_materiality": {"enum": ["MATERIAL", "NON_MATERIAL", "UNKNOWN"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "integration_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["integration_id", "time", "target", "result", "selection_state_at_commit"],
        "properties": {
          "integration_id": {"type": "string", "minLength": 1},
          "time": {"type": "string", "format": "date-time"},
          "target": {"type": "string", "minLength": 1},
          "authority_basis": {"type": "string"},
          "recovery_boundary": {"type": "string"},
          "scope": {"type": "string"},
          "result": {"enum": ["COMMITTED", "DEFERRED", "REJECTED", "UNKNOWN"]},
          "residuals": {"type": "array", "items": {"type": "string"}},
          "selection_state_at_commit": {"enum": ["SUPPORTED", "PARTIAL", "UNKNOWN"]},
          "expression_state_at_commit": {"enum": ["LATENT", "EXPRESSED"]},
          "authority_boundary": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "archive": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["time", "reason", "selection_state_preserved"],
          "properties": {
            "time": {"type": "string", "format": "date-time"},
            "reason": {"type": "string", "minLength": 1},
            "record_retention": {"type": "string"},
            "retention_note": {"type": "string"},
            "selection_state_preserved": {"enum": ["UNASSESSED", "SUPPORTED", "PARTIAL", "NOT_SUPPORTED", "HARMFUL", "UNKNOWN"]}
          },
          "additionalProperties": true
        }
      ]
    },
    "migration": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": [
            "source_candidate_id",
            "source_selection_state",
            "source_lifecycle_state",
            "packet_purpose",
            "transfer_status",
            "source_authentication",
            "packet_sha256",
            "source_negative_lineage_refs",
            "source_experiments",
            "source_evaluations",
            "source_integration_history"
          ],
          "properties": {
            "source_candidate_id": {"type": "string", "minLength": 1},
            "source_selection_state": {"enum": ["UNASSESSED", "SUPPORTED", "PARTIAL", "NOT_SUPPORTED", "HARMFUL", "UNKNOWN"]},
            "source_lifecycle_state": {"enum": ["PROPOSED", "EXPERIMENTED", "INTEGRATED", "ARCHIVED", "RETIRED"]},
            "packet_purpose": {"enum": ["ADAPTATION_CANDIDATE", "NEGATIVE_EVIDENCE", "UNRESOLVED_VARIATION"]},
            "transfer_status": {"type": "string", "minLength": 1},
            "source_authentication": {"type": "string", "minLength": 1},
            "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "source_negative_lineage_refs": {"type": "array", "items": {"type": "string"}},
            "material_differences": {"type": "array", "items": {"type": "string"}},
            "source_environment": {"type": "object"},
            "source_experiments": {"type": "array", "items": {"type": "object"}},
            "source_evaluations": {"type": "array", "items": {"type": "object"}},
            "source_integration_history": {"type": "array", "items": {"type": "object"}},
            "source_archive": {"type": ["object", "null"]},
            "source_migration": {"type": ["object", "null"]},
            "source_expression_state": {"enum": ["LATENT", "EXPRESSED"]},
            "source_expression_history": {"type": "array", "items": {"type": "object"}},
            "source_last_expressed_at": {"type": ["string", "null"], "format": "date-time"}
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"expression_state": {"const": "EXPRESSED"}}, "required": ["expression_state"]},
      "then": {"properties": {"expression_history": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"selection_state": {"enum": ["SUPPORTED", "PARTIAL", "NOT_SUPPORTED", "HARMFUL", "UNKNOWN"]}}, "required": ["selection_state"]},
      "then": {"properties": {"evaluations": {"minItems": 1}, "experiments": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"lifecycle_state": {"const": "INTEGRATED"}}, "required": ["lifecycle_state"]},
      "then": {"properties": {"integration_history": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"lifecycle_state": {"enum": ["ARCHIVED", "RETIRED"]}}, "required": ["lifecycle_state"]},
      "then": {"properties": {"archive": {"type": "object"}}}
    },
    {
      "if": {"properties": {"origin": {"const": "MIGRATION_CANDIDATE"}}, "required": ["origin"]},
      "then": {
        "required": ["source_candidate_id", "source_packet_sha256"],
        "properties": {"migration": {"type": "object"}}
      }
    }
  ],
  "additionalProperties": false
}

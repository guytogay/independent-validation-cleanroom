{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ENA Recovery History Transition v1",
  "type": "object",
  "required": ["transition_id", "state_restore", "history_continuity", "recovery_claim"],
  "properties": {
    "transition_id": {"type": "string"},
    "state_restore": {"type": "object", "required": ["target_checkpoint", "result"], "properties": {"target_checkpoint": {"type": "string"}, "result": {"type": "string", "enum": ["SUCCESS", "FAILED", "PARTIAL", "UNKNOWN"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "history_continuity": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string", "enum": ["PRESERVED", "PARTIAL", "GAP_VISIBLE", "UNKNOWN", "FAILED"]}, "post_checkpoint_occurrence_delta_captured": {"type": ["boolean", "null"]}, "known_gap": {"type": ["string", "null"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "projection_rebuild": {"type": "object", "properties": {"required": {"type": "boolean"}, "result": {"type": "string", "enum": ["SUCCESS", "FAILED", "NOT_REQUIRED", "UNKNOWN"]}}, "additionalProperties": true},
    "recovery_claim": {"type": "object", "required": ["claim_ref", "scope"], "properties": {"claim_ref": {"type": "string"}, "scope": {"type": "string"}}, "additionalProperties": true}
  },
  "additionalProperties": true
}

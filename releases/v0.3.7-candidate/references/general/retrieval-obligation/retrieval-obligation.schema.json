{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ena/research/memory-metabolism/retrieval-obligation-0.5/schema.json",
  "title": "ENA Memory Metabolism Triggered Retrieval Obligation Research 0.5",
  "type": "object",
  "required": ["schema_version","decisions","trigger_events","retrieval_intents","obligations","scope_discoveries","attempts","sufficiency_resolutions"],
  "properties": {
    "schema_version": {"const":"memory-retrieval-obligation-research-0.5"},
    "decisions": {"type":"array","items":{"$ref":"#/$defs/decision"}},
    "trigger_events": {"type":"array","items":{"$ref":"#/$defs/trigger"}},
    "retrieval_intents": {"type":"array","items":{"$ref":"#/$defs/intent"}},
    "obligations": {"type":"array","items":{"$ref":"#/$defs/obligation"}},
    "scope_discoveries": {"type":"array","items":{"$ref":"#/$defs/discovery"}},
    "attempts": {"type":"array","items":{"$ref":"#/$defs/attempt"}},
    "sufficiency_resolutions": {"type":"array","items":{"$ref":"#/$defs/sufficiency_resolution"}}
  },
  "additionalProperties": false,
  "$defs": {
    "decision":{"type":"object","required":["decision_id","consequence","disposition","uncertainty_declared"],"properties":{"decision_id":{"type":"string","minLength":1},"consequence":{"enum":["NON_MATERIAL","MATERIAL"]},"disposition":{"enum":["READY","PROCEED_UNCERTAIN","NARROWED","ABSTAINED"]},"uncertainty_declared":{"type":"boolean"},"notes":{"type":"string"}},"additionalProperties":false},
    "trigger":{"type":"object","required":["trigger_id","decision_id","basis","resolver_ref"],"properties":{"trigger_id":{"type":"string","minLength":1},"decision_id":{"type":"string","minLength":1},"basis":{"enum":["GENERIC_REFLEX","HOST_SIGNAL","EXPLICIT_USER","KNOWN_GAP","OTHER"]},"resolver_ref":{"type":"string","minLength":1,"description":"Logical resolver / trust-equivalence identity; not necessarily a physical instance."},"notes":{"type":"string"}},"additionalProperties":false},
    "intent":{"type":"object","required":["intent_id","decision_id","trigger_ids","resolver_ref","decision_context_snapshot_ref","need_basis"],"properties":{"intent_id":{"type":"string","minLength":1},"decision_id":{"type":"string","minLength":1},"trigger_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"resolver_ref":{"type":"string","minLength":1,"description":"Logical resolver / trust-equivalence identity."},"need_basis":{"enum":["DURABLE_STATE_MAY_CHANGE_DECISION","CONTINUITY_AMBIGUITY","REPEATED_FAILURE","ENVIRONMENT_CHANGE","EXPLICIT_USER","KNOWN_GAP","OTHER"]},"decision_context_snapshot_ref":{"type":"string","minLength":1,"description":"Opaque immutable/versioned reference to the bounded decision-context snapshot used for retrieval."},"notes":{"type":"string"}},"additionalProperties":false},
    "closure":{"type":"object","required":["disposition","basis_discovery_id","basis_attempt_ids"],"properties":{"disposition":{"enum":["RETRIEVAL_SUFFICIENCY_RESOLVED","NO_HIT_BOUNDED","UNCERTAIN_CONTINUATION","CONSEQUENCE_NARROWED","ABSTAINED"]},"basis_discovery_id":{"type":"string","minLength":1},"basis_attempt_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"sufficiency_resolution_ref":{"type":"string","minLength":1},"notes":{"type":"string"}},"additionalProperties":false},
    "obligation":{"type":"object","required":["obligation_id","decision_id","intent_id","resolver_ref","state"],"properties":{"obligation_id":{"type":"string","minLength":1},"decision_id":{"type":"string","minLength":1},"intent_id":{"type":"string","minLength":1},"resolver_ref":{"type":"string","minLength":1,"description":"Logical resolver / trust-equivalence identity."},"state":{"enum":["PENDING","ATTEMPTED","CLOSED"]},"closure":{"$ref":"#/$defs/closure"},"notes":{"type":"string"}},"additionalProperties":false},
    "discovery":{"type":"object","required":["discovery_id","obligation_id","sequence","resolver_ref","registry_snapshot_ref","selected_scope_refs","outcome","coverage","subject_relevance","receipt_ref"],"properties":{"discovery_id":{"type":"string","minLength":1},"obligation_id":{"type":"string","minLength":1},"sequence":{"type":"integer","minimum":1},"resolver_ref":{"type":"string","minLength":1},"registry_snapshot_ref":{"type":"string","minLength":1},"selected_scope_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"outcome":{"enum":["SCOPES_SELECTED","NO_RELEVANT_SCOPE","FAILED","UNKNOWN"]},"coverage":{"enum":["DECLARED_DISCOVERY_COMPLETE","PARTIAL","UNKNOWN"]},"subject_relevance":{"enum":["DECISION_MATERIAL","NON_MATERIAL_OBSERVATION"],"description":"Reference classification only; validator does not prove materiality."},"receipt_ref":{"type":"string","minLength":1},"notes":{"type":"string"}},"additionalProperties":false},
    "returned_result":{"type":"object","required":["record_ref","content_identity_ref"],"properties":{"record_ref":{"type":"string","minLength":1},"content_identity_ref":{"type":"string","minLength":1,"description":"Immutable/versioned identity of the effective returned content as represented by the Host."}},"additionalProperties":false},
    "attempt":{"type":"object","required":["attempt_id","obligation_id","discovery_id","scope_ref","sequence","resolver_ref","outcome","coverage","subject_relevance","returned_results","receipt_ref"],"properties":{"attempt_id":{"type":"string","minLength":1},"obligation_id":{"type":"string","minLength":1},"discovery_id":{"type":"string","minLength":1},"scope_ref":{"type":"string","minLength":1},"sequence":{"type":"integer","minimum":1},"resolver_ref":{"type":"string","minLength":1},"outcome":{"enum":["HIT","NO_HIT","PARTIAL","FAILED","UNKNOWN"]},"coverage":{"enum":["DECLARED_SCOPE_COMPLETE","PARTIAL","UNKNOWN"]},"subject_relevance":{"enum":["DECISION_MATERIAL","NON_MATERIAL_OBSERVATION"],"description":"Reference classification only; false classification remains external."},"returned_results":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/returned_result"}},"receipt_ref":{"type":"string","minLength":1},"notes":{"type":"string"}},"additionalProperties":false},
    "sufficiency_resolution":{"type":"object","required":["resolution_ref","subject_fingerprint","receipt_ref"],"properties":{"resolution_ref":{"type":"string","minLength":1},"subject_fingerprint":{"type":"string","minLength":1},"receipt_ref":{"type":"string","minLength":1},"notes":{"type":"string"}},"additionalProperties":false}
  }
}
